{
  "name": "Buổi 4 - Máy Sản Xuất Content Sheet to OpenAI to Facebook Page",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "[YOUR_GOOGLE_SHEET_ID_HERE]",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Ideas",
          "mode": "list"
        },
        "event": "rowAdded"
      },
      "id": "node-sheets-trigger",
      "name": "Google Sheets Trigger (New Topic)",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "content": "Bạn là Chuyên gia Marketing Facebook với công thức viết bài AIDA thu hút. Hãy viết bài đăng hấp dẫn kèm Hashtag từ chủ đề được cấp."
            },
            {
              "role": "user",
              "content": "=Hãy viết bài đăng Facebook chuẩn Marketing từ ý tưởng này: {{ $json.Topic }}"
            }
          ]
        }
      },
      "id": "node-openai-writer",
      "name": "OpenAI Content Generator Node",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [480, 300],
      "credentials": {
        "openAiApi": {
          "id": "[YOUR_OPENAI_CREDENTIAL_ID]",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.page_id }}/feed",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.message.content }}"
            },
            {
              "name": "access_token",
              "value": "[YOUR_FACEBOOK_PAGE_ACCESS_TOKEN]"
            }
          ]
        }
      },
      "id": "node-facebook-post",
      "name": "Facebook Graph API Post Node",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Google Sheets Trigger (New Topic)": {
      "main": [
        [
          {
            "node": "OpenAI Content Generator Node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Content Generator Node": {
      "main": [
        [
          {
            "node": "Facebook Graph API Post Node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
